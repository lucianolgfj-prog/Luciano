# Copie para .env; valores abaixo são apenas para desenvolvimento local.
DATABASE_URL=postgresql://jda:jda_local_only@localhost:5432/jda?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
APP_MODE=demo
DEMO_LOGIN_ENABLED=true
# Produção: APP_MODE=production, DEMO_LOGIN_ENABLED=false; nenhuma identidade demo é aceita.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Allowlist de exatamente três identidades; correspondem aos papéis indicados.
LUCIANO_EMAIL=
RAFAEL_EMAIL=
GUSTAVO_EMAIL=
# Graph: credenciais de aplicativo do servidor, com consentimento e escopo restrito.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
OUTLOOK_MAILBOX=
JUSBRASIL_SENDER=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_ROOT_ID=
ONEDRIVE_LEADS_ITEM_ID=
# Planilha .xlsx, tabela nomeada com colunas Nome, Email, Telefone, Etapa.
ONEDRIVE_LEADS_TABLE=Leads
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_MEETINGS_DATABASE_ID=
# Properties do banco de tarefas: Nome(title), Status(status), JDA ID(rich_text).
NOTION_TITLE_PROPERTY=Nome
NOTION_STATUS_PROPERTY=Status
NOTION_EXTERNAL_ID_PROPERTY=JDA ID
NOTION_PENDING_STATUS=Não iniciada
# Escrita externa é bloqueada por padrão, inclusive no modo demo.
ALLOW_EXTERNAL_WRITES=false
